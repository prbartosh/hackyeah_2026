# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Backend
APP_NAME=hackyeah-api
DEBUG=true
# Front serwowany przez nginx z proxy /api, CORS potrzebny tylko dla `npm run dev`
CORS_ORIGINS=["http://localhost:5173"]

# LLM (matchmaking, DeepSeek)
# Profil dostawcy: deepseek albo openai (ADR 0010)
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# low / high / max; puste = domyślne (high)
LLM_REASONING_EFFORT=low
# Limit wyjścia jednego wywołania (razem z tokenami rozumowania)
LLM_MAX_COMPLETION_TOKENS=8000
# Tokeny (wejście + wyjście) na dzień, potem czat odpowiada 503; puste = bez limitu.
# Wspólny dla czatu, karty usługi i panelu. Zużycie w logach „LLM turn” backendu.
LLM_DAILY_TOKEN_LIMIT=300000
# false = czat wyłączony bez nowego wdrożenia
CHAT_ENABLED=true

# Frontend (wstrzykiwane przy buildzie obrazu)
VITE_API_URL=/api/v1

# Panel administratora (ADR 0006): bez tokenu panel jest wyłączony
ADMIN_TOKEN=
# Cel czasu odpowiedzi na zgłoszenie (godziny) i dzienny limit wywołań AI w panelu
SLA_HOURS=48
AI_DAILY_CALL_LIMIT=200
MAX_UPLOAD_MB=10
# Kreator pomysłów (publiczny): dzienny limit wywołań AI, osobny od panelu
KREATOR_AI_DAILY_CALL_LIMIT=100
# log = wiadomości tylko w logu (adapter, bez wysyłki SMTP)
EMAIL_BACKEND=log
# Adres (e-mail) do powiadomień o nowych zgłoszeniach i adres publiczny aplikacji do linków w wiadomościach
ADMIN_NOTIFY_EMAIL=
PUBLIC_BASE_URL=http://localhost:8080
