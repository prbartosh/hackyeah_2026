# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Backend
APP_NAME=hackyeah-api
DEBUG=true
# Front serwowany przez nginx z proxy /api, CORS potrzebny tylko dla `npm run dev`
CORS_ORIGINS=["http://localhost:5173"]

# LLM (matchmaking, OpenAI)
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-sol
# Tylko modele rozumujące; zostaw puste dla modeli bez reasoning_effort
LLM_REASONING_EFFORT=low

# Frontend (wstrzykiwane przy buildzie obrazu)
VITE_API_URL=/api/v1
