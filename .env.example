# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Backend
APP_NAME=hackyeah-api
DEBUG=true
# Front serwowany przez nginx z proxy /api, CORS potrzebny tylko dla `npm run dev`
CORS_ORIGINS=["http://localhost:5173"]

# LLM (matchmaking, OpenAI)
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-sol
# Tylko modele rozumujące; zostaw puste dla modeli bez reasoning_effort
LLM_REASONING_EFFORT=low
# Limit wyjścia jednego wywołania (razem z tokenami rozumowania)
LLM_MAX_COMPLETION_TOKENS=8000
# Tokeny (wejście + wyjście) na dzień, potem czat odpowiada 503; puste = bez limitu.
# Ustawić po zmierzeniu typowej rozmowy (logi „LLM turn” w backendzie).
# LLM_DAILY_TOKEN_LIMIT=2000000
# false = czat wyłączony bez nowego wdrożenia
CHAT_ENABLED=true

# Frontend (wstrzykiwane przy buildzie obrazu)
VITE_API_URL=/api/v1

# Panel administratora (ADR 0006): bez tokenu panel jest wyłączony
ADMIN_TOKEN=
EMBEDDING_MODEL=text-embedding-3-small
# Cel czasu odpowiedzi na zgłoszenie (godziny) i dzienny limit wywołań AI w panelu
SLA_HOURS=48
AI_DAILY_CALL_LIMIT=200
MAX_UPLOAD_MB=10
# log = wiadomości tylko w logu (adapter, bez wysyłki SMTP)
EMAIL_BACKEND=log
# Adres (e-mail) do powiadomień o nowych zgłoszeniach i adres publiczny aplikacji do linków w wiadomościach
ADMIN_NOTIFY_EMAIL=
PUBLIC_BASE_URL=http://localhost:8080
