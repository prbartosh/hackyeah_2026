# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Backend
APP_NAME=hackyeah-api
DEBUG=true
# Front serwowany przez nginx z proxy /api, CORS potrzebny tylko dla `npm run dev`
CORS_ORIGINS=["http://localhost:5173"]

# LLM (matchmaking, DeepSeek)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# low / high / max; puste = domyślne (high)
LLM_REASONING_EFFORT=low
# Limit wyjścia jednego wywołania (razem z tokenami rozumowania)
LLM_MAX_COMPLETION_TOKENS=8000
# Tokeny (wejście + wyjście) na dzień, potem czat odpowiada 503; puste = bez limitu.
# Ustawić po zmierzeniu typowej rozmowy (logi „LLM turn” w backendzie).
# LLM_DAILY_TOKEN_LIMIT=2000000
# false = czat wyłączony bez nowego wdrożenia
CHAT_ENABLED=true

# Frontend (wstrzykiwane przy buildzie obrazu)
VITE_API_URL=/api/v1
